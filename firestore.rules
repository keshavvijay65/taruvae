rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for authenticated users for now to unblock
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // specific rules for users collection
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
